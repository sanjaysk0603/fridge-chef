# Copy this file to .streamlit/secrets.toml and fill in your real values.
# Never commit the real secrets.toml.

GEMINI_API_KEY = "your-gemini-api-key-here"

# Gmail account that sends the emails.
GMAIL_ADDRESS = "yourname@gmail.com"

# 16-character App Password from myaccount.google.com/apppasswords
# (requires 2-Step Verification). Not your normal Gmail password.
GMAIL_APP_PASSWORD = "your-16-character-app-password"